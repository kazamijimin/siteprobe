# Development-only read adapter for already-persisted controlled evaluations.
QA_EVALUATION_PUBLIC_READ_ENABLED=false
# Development-only read adapter for persisted accessibility evaluations.
ACCESSIBILITY_EVALUATION_PUBLIC_READ_ENABLED=false
# Development-only authenticated ingestion allowlist for the ReaDirect smoke test.
REAL_SITE_SMOKE_TEST_ENABLED=false
# Development-only read adapter for persisted SEO evaluations.
SEO_EVALUATION_PUBLIC_READ_ENABLED=false
