HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://siteprobe:siteprobe@127.0.0.1:5432/siteprobe
SCANNER_URL=http://127.0.0.1:3100
SCANNER_INTERNAL_TOKEN=
# Optional token for authenticated internal QA evaluation persistence routes.
