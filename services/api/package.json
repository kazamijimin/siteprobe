{
  "name": "@siteprobe/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx/esm src/db/migrate.ts",
    "db:test": "vitest run --no-file-parallelism src/db/repository.test.ts src/db/qa-evaluation-repository.test.ts src/db/controlled-fixture-workflow.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx/esm src/server.ts",
    "pretypecheck": "pnpm --filter @siteprobe/contracts build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @siteprobe/contracts build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@siteprobe/contracts": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.0.0",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@siteprobe/controlled-evaluations": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
