{
  "name": "@siteprobe/scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./controlled-fixtures": {
      "types": "./src/controlled-fixtures/index.ts",
      "import": "./src/controlled-fixtures/index.ts",
      "default": "./src/controlled-fixtures/index.ts"
    },
    "./controlled-accessibility": {
      "types": "./src/controlled-accessibility.ts",
      "import": "./src/controlled-accessibility.ts",
      "default": "./src/controlled-accessibility.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/server.ts",
    "install-browser": "playwright install chromium",
    "start": "node --env-file-if-exists=.env --import tsx/esm src/server.ts",
    "pretypecheck": "pnpm --filter @siteprobe/contracts build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @siteprobe/contracts build",
    "test": "vitest run"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@siteprobe/contracts": "workspace:*",
    "fastify": "^5.0.0",
    "playwright": "1.62.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
