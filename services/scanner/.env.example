SCANNER_HOST=127.0.0.1
SCANNER_PORT=3100
SCANNER_INTERNAL_TOKEN=replace-with-a-long-random-server-only-token
SCANNER_EXECUTION_MODE=controlled
SCANNER_CONTROLLED_HOSTS=example.com

# Trusted deployment declarations. Defaults are not-verified and fail closed in isolated mode.
SCANNER_CAP_NETWORK_ISOLATION=not-verified
SCANNER_CAP_PRIVATE_NETWORK_BLOCKED=not-verified
SCANNER_CAP_METADATA_BLOCKED=not-verified
SCANNER_CAP_DATABASE_NETWORK_BLOCKED=not-verified
SCANNER_CAP_HOST_NETWORK_BLOCKED=not-verified
SCANNER_CAP_NON_ROOT_EXECUTION=not-verified
SCANNER_CAP_BROWSER_SANDBOX_ENABLED=not-verified
SCANNER_CAP_SENSITIVE_MOUNTS_ABSENT=not-verified
SCANNER_CAP_RESOURCE_LIMITS=not-verified
