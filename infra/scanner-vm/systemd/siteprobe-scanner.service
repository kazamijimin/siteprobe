[Unit]
Description=SiteProbe isolated scanner worker
After=network-online.target squid.service unbound.service
Wants=network-online.target
Requires=squid.service unbound.service

[Service]
Type=simple
User=siteprobe-scanner
Group=siteprobe-scanner
WorkingDirectory=/opt/siteprobe
EnvironmentFile=/etc/siteprobe/scanner.env
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/siteprobe/ms-playwright
ExecStart=/usr/bin/node /opt/siteprobe/services/scanner/dist/server.js
Restart=on-failure
RestartSec=2s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/siteprobe/scanner /run/siteprobe
MemoryMax=768M
TasksMax=128
CPUQuota=100%
LimitNOFILE=4096

# Do not add --no-sandbox. Chromium must retain its sandbox.

[Install]
WantedBy=multi-user.target
