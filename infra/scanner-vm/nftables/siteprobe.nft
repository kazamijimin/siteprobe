#!/usr/sbin/nft -f

# Replace these addresses and UIDs during deployment. Keep the scanner UID
# separate from the proxy/resolver service UIDs.
define scanner_uid = 997
define proxy_uid = 996
define resolver_uid = 995
define proxy_ipv4 = 10.20.0.2
define resolver_ipv4 = 10.20.0.53
define resolver_ipv6 = fd42:51:5445:7072::53
define upstream_resolver_ipv4 = 1.1.1.1

table inet siteprobe {
  set blocked_ipv4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4, 169.254.169.254/32,
      10.20.0.0/24
    }
  }

  set blocked_ipv6 {
    type ipv6_addr
    flags interval
    elements = {
      ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8,
      2001:db8::/32, fd00:ec2::254/128, fd20:ce::254/128,
      ::ffff:0:0/96,
      fd42:51:5445:7072::/64
    }
  }

  chain output {
    type filter hook output priority filter; policy accept;

    # The scanner can only emit established control responses, DNS to the
    # controlled resolver, and HTTP(S) to the mandatory proxy. All other new
    # scanner-originated traffic is denied for both address families.
    meta skuid $scanner_uid jump scanner_output

    # The proxy may reach the public network on behalf of the scanner. Its
    # independent Squid destination ACL remains mandatory.
    meta skuid $proxy_uid tcp dport { 80, 443 } accept
    meta skuid $resolver_uid ip daddr $upstream_resolver_ipv4 udp dport 53 accept
    meta skuid $resolver_uid ip daddr $upstream_resolver_ipv4 tcp dport 53 accept
  }

  chain scanner_output {
    ct state established,related accept
    oifname "lo" drop
    udp dport 443 drop
    ip daddr @blocked_ipv4 drop
    ip6 daddr @blocked_ipv6 drop
    ip daddr $resolver_ipv4 udp dport 53 accept
    ip daddr $resolver_ipv4 tcp dport 53 accept
    ip6 daddr $resolver_ipv6 udp dport 53 accept
    ip6 daddr $resolver_ipv6 tcp dport 53 accept
    ip daddr $proxy_ipv4 tcp dport 3128 accept
    drop
  }
}
