# Loopback API origin only. The P7 tool rejects remote origins.
SITEPROBE_API_URL=http://127.0.0.1:3000

# Server-side token for POST /internal/qa-evaluations.
QA_EVALUATION_INTERNAL_TOKEN=

# The real-site command uses the same server-side token; it is never logged or
# exposed to Expo. Enable the matching API development flag before running it.
